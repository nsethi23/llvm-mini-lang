// Casts (`as`) and boolean operators, including short-circuiting.
fn isEven(n: int) -> bool {
    return n % 2 == 0;
}

fn main() -> int {
    let x: int = 7;
    let asFloat: float = x as float;
    print(asFloat);

    print(isEven(4) && isEven(6));
    print(isEven(4) && isEven(5));
    print(isEven(3) || isEven(4));
    return 0;
}
